{"attempt_id": "attempt:um-ep-84-erd-s-problem-84-baf39534-source-fidelity-01", "created_at": "2026-09-06T08:00:00Z", "graph_id": "graph:um-ep-84-erd-s-problem-84-baf39534-v1", "obligations": [{"acceptance": {"allowed_candidate_kinds": ["proof", "counterexample", "formalization", "computation"], "required_capabilities": ["human_review", "statement_faithfulness"]}, "dependencies": ["obligation:um-ep-84-erd-s-problem-84-baf39534-statement-fidelity"], "kind": "root_claim", "obligation_id": "obligation:um-ep-84-erd-s-problem-84-baf39534-root", "source_refs": ["https://www.unsolvedmath.com/problems/EP-84"], "statement": {"formal_declaration": null, "language": "en", "text": "The cycle set of a graph $G$ on $n$ vertices is a set $A\\subseteq \\{3,\\ldots,n\\}$ such that there is a cycle in $G$ of length $\\ell$ if and only if $\\ell \\in A$. Let $f(n)$ count the number of possible such $A$. Prove that $f(n)=o(2^n)$. Prove that $f(n)/2^{n/2}\\to \\infty$."}, "statement_sha256": "49b9445f21c7a06664b88066eb13c2734da70e2f0bfd0cc10f240aa2449a19d1"}, {"acceptance": {"allowed_candidate_kinds": ["proof"], "required_capabilities": ["human_review", "statement_faithfulness"]}, "dependencies": [], "kind": "definition", "obligation_id": "obligation:um-ep-84-erd-s-problem-84-baf39534-statement-fidelity", "source_refs": ["https://www.unsolvedmath.com/problems/EP-84"], "statement": {"formal_declaration": null, "language": "en", "text": "Verify against the cited source that the frozen statement is complete, current, untruncated, attribution-correct, and unambiguous enough for mathematical research; record any definition or quantifier gap without silently editing the contract."}, "statement_sha256": "65f0b3d574bd6d837403149dab6434c0f571709f7eb5bb066c7e8774bad13f34"}], "problem_contract_sha256": "5bb94d43fb0bbeb9f0e18b1a743c9cef3672b9a5706724fa057b3f69ecf24060", "problem_id": "problem:um-ep-84-erd-s-problem-84-baf39534", "root_obligation_id": "obligation:um-ep-84-erd-s-problem-84-baf39534-r